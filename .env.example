
# ============================================================
# Neobee Hospital PLC — Stakeholder Finance Portal
# Template only. Copy to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed; this file is.
# ============================================================

# --- Database -------------------------------------------------
# REQUIRED. PostgreSQL connection string. Used by the app
# (lib/db.ts), Prisma, and the seed scripts.
#   Local Postgres:
#     postgresql://postgres:YOUR-PASSWORD@localhost:5432/postgres
#   Supabase (session-mode pooler, port 5432):
#     postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@localhost:5432/postgres"

# OPTIONAL. Direct connection used ONLY by migrations. Needed when
# DATABASE_URL points at a transaction-mode pooler (Supabase port
# 6543), because DDL must run on a session/direct connection.
# Leave unset for plain local Postgres or a session-mode (5432) URL.
# DIRECT_URL="postgresql://..."

# OPTIONAL. Controls how `pnpm db:deploy` (scripts/migrate.mjs)
# migrates the database:
#   "supabase" — runs every migration, including 1_rls (Row Level
#                Security policies that target Supabase roles).
#   "generic"  — skips 1_rls (meaningless without Supabase roles)
#                and applies the rest.
# Unset = inferred from the DATABASE_URL host: *.supabase.co or
# pooler.supabase.com -> "supabase"; anything else -> "generic".
# Set it to exactly "supabase" or "generic" — any other value takes
# a psql-based compat-shim migration path instead.
NEOBEE_DB_PROVIDER="generic"

# --- Email (Brevo) --------------------------------------------
# REQUIRED to send OTP emails. Brevo REST API key (xkeysib-...).
# The API key authenticates the whole Brevo account — no username
# is needed. Without it: in development the OTP is printed to the
# server console instead; in production sending fails.
BREVO_API_KEY=""

# OPTIONAL. "From" address for OTP emails. Must be verified as a
# sender in the Brevo dashboard, or Brevo rejects the send.
# Defaults to no-reply@neobeehospital.com when unset.
BREVO_SENDER_EMAIL="no-reply@neobeehospital.com"

# --- File storage (NID scans, deposit slips) ------------------
# OPTIONAL. "local" stores uploads on disk; "supabase" stores them
# in Supabase Storage. Unset defaults to "supabase".
# Use "local" for local development and the self-hosted VPS target.
NEOBEE_STORAGE_PROVIDER="local"

# OPTIONAL. Upload directory when NEOBEE_STORAGE_PROVIDER="local".
# Defaults to <repo>/storage-uploads.
NEOBEE_STORAGE_DIR=""

# NEEDED ONLY when NEOBEE_STORAGE_PROVIDER="supabase".
# The service-role key is server-side only — never expose it to the
# browser or commit it to git.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

# --- App / deployment -----------------------------------------
# OPTIONAL. Public origin of the deployed site. Used to build the
# scannable QR links printed on receipts and certificates. In
# development it falls back to localhost; set it once the app runs
# on a real domain.
NEXT_PUBLIC_SITE_URL=""

# --- Seeding & demo mode --------------------------------------
# OPTIONAL. Seed scripts refuse to run when NODE_ENV=production.
# Set to "true" to allow seeding in production. Leave unset otherwise.
SEED_ALLOW=""

# OPTIONAL. Enables the demo login buttons outside development.
DEMO_LOGIN=""

# RARELY HAND-SET. In-memory demo dataset flags; scripts/demo.mjs
# writes these when you run the in-memory demo mode.
DEMO_DATA=""
NEXT_PUBLIC_DEMO_DATA=""
