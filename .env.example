# =============================================================================
# BLOCK 1 — DATABASE (works with any Postgres)
# =============================================================================
# The Postgres URL — paste your laptop's local Postgres (e.g.
# postgresql://postgres:postgres@localhost:5432/postgres), your Supabase
# project's direct connection string, or a Neon connection string.
# Used by the app, the seed script, and (unless DIRECT_URL is set) Prisma migrations.
DATABASE_URL=
# Optional override — only needed when DATABASE_URL is a POOLED connection
# (Supabase Supavisor port 6543, or a Neon pooler URL), because Prisma Migrate
# requires a direct connection. Paste the direct string here. When unset,
# migrations simply use DATABASE_URL; local Postgres never needs this.
DIRECT_URL=

# Optional. supabase | generic. When unset, the deploy runner infers from the
# host: Supabase hosts get a plain deploy; anything else (local/Neon) gets the
# compat shim applied so 1_rls and RLS stay active. Set generic only to
# deliberately skip 1_rls and run WITHOUT RLS (API layer becomes the only
# enforcement).
NEOBEE_DB_PROVIDER=

# =============================================================================
# BLOCK 2 — SUPABASE AUTH + STORAGE (required regardless of where the database lives)
# =============================================================================
# These are Supabase services (phone/OTP auth, file storage), needed even when
# DATABASE_URL points elsewhere.
NEXT_PUBLIC_SUPABASE_URL=                    # Public Supabase project URL for the browser client
NEXT_PUBLIC_SUPABASE_ANON_KEY=              # Public Supabase anon key for browser client requests
SUPABASE_SERVICE_ROLE_KEY=                   # Server-only — never bundled to the client
SUPABASE_STORAGE_BUCKET=                     # Storage bucket name used for uploads

# =============================================================================
# BLOCK 3 — OPTIONAL / TOOLING
# =============================================================================
# Production seed override — must be explicitly 'true' to allow seeding when NODE_ENV=production
# SEED_ALLOW="true"
# Set to 'true' to enable demo login outside development (demo users are created by the seed script)
DEMO_LOGIN=