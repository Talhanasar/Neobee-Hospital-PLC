# =============================================================================
# BLOCK 1 — DATABASE (required)
# =============================================================================
# The Postgres URL — paste your laptop's local Postgres (e.g.
# postgresql://postgres:postgres@localhost:5432/postgres), your Supabase
# project's direct connection string, or a Neon connection string.
# Used by the app, the seed script, and (unless DIRECT_URL is set) Prisma
# migrations. In DEMO_DATA presentation mode it is loaded but never queried.
DATABASE_URL=

# Optional — only needed when DATABASE_URL is a POOLED connection (Supabase
# Supavisor port 6543, or a Neon pooler URL), because Prisma Migrate requires
# a direct connection. Paste the direct string here. When unset, migrations
# simply use DATABASE_URL; local Postgres never needs this.
# DIRECT_URL=

# Optional — supabase | generic. When unset, the deploy runner infers from the
# host: Supabase hosts get a plain deploy; anything else (local/Neon) gets the
# compat shim applied so 1_rls and RLS stay active. Set generic only to
# deliberately skip 1_rls and run WITHOUT RLS (API layer becomes the only
# enforcement).
# NEOBEE_DB_PROVIDER=

# =============================================================================
# BLOCK 2 — SUPABASE AUTH + STORAGE (required for real-data mode)
# =============================================================================
# These are Supabase services (phone/OTP auth, file storage), needed whenever
# the app serves real data — even when DATABASE_URL points elsewhere. Pure
# demo mode (DEMO_DATA=true) makes no Supabase calls and can leave these unset.
NEXT_PUBLIC_SUPABASE_URL=                    # Public Supabase project URL for the browser client
NEXT_PUBLIC_SUPABASE_ANON_KEY=              # Public Supabase anon key for browser client requests
SUPABASE_SERVICE_ROLE_KEY=                   # Server-only — never bundled to the client
SUPABASE_STORAGE_BUCKET=                     # Storage bucket name used for uploads

# =============================================================================
# BLOCK 3 — OPTIONAL TOGGLES (commented = off; unset means disabled)
# =============================================================================
# Production seed override — must be explicitly 'true' to allow seeding when
# NODE_ENV=production.
# SEED_ALLOW="true"

# Demo login, Supabase-backed: shows the one-click demo tiles on /login and
# lets them sign in as the seeded demo accounts (created by `pnpm db:seed`).
# Requires a reachable Supabase project and a seeded database. Off in every
# environment (including development) unless explicitly 'true'.
# DEMO_LOGIN="true"

# Pure in-repo demo dataset (data/demo/) served from memory instead of the
# database — presentation mode with NO Postgres/Supabase dependency. This is
# also what makes the demo login tiles appear. `node scripts/demo.mjs` sets
# it automatically; leave unset for real data.
# DEMO_DATA="true"

# Client-side mirror of DEMO_DATA — must be set to the same value whenever
# DEMO_DATA is (scripts/demo.mjs sets both). Server-side reads ignore it.
# NEXT_PUBLIC_DEMO_DATA="true"
